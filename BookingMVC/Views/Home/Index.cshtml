@{
    ViewData["Title"] = "HotelsForyou";
}
@model HotelViewModel

<div class="home-page">
    <section class="home-hero">
        <h1>Find your next stay</h1>
        <p>Browse hotels, check availability and book in a few clicks.</p>
        <a href="#hotels" class="hero-btn">Browse hotels</a>
    </section>

    <div class="section-head" id="hotels">
        <h2>Hotels</h2>
        <span>@Model.Hotels.Count() places to stay</span>
</div>
<hr />
<h2> Hotels</h2>
<div style="display:flex; flex-wrap:wrap;">
@foreach(var hotel in Model.Hotels)
{
    <div style="width:33%; padding:15px; text-align:center;">
        <partial name="_HotelCard" model="hotel" />
    </div>
}
</div>