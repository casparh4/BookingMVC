@model Hotel

<a asp-controller="Hotel"
   asp-action="Details"
   asp-route-id="@Model.HotelId">
    <img class="hotel-card__img" src="@Model.ImageUrl" alt="@Model.Name" loading="lazy" />
    <div class="hotel-card__body">
        <h3 class="hotel-card__name">@Model.Name</h3>
        <p class="hotel-card__location">@Model.City, @Model.Country</p>
</div>
</a>

